{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minilytics-cf",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; the dashboard and /js/script.js are served as free static files.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      // No database_id: the Deploy button, or the first `npm run deploy`, creates the database and finds it by name after.
      "migrations_dir": "migrations","database_id": "cf2d143a-8eff-4e68-b1f9-46fc788dccf1"
    }
  ]
}
