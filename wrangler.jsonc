{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minilytics-cf",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Static files skip the Worker. Anything else (client routes, unknown paths) runs it so missing pages return a real 404.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      // No database_id: the Deploy button, or the first `npm run deploy`, creates the database and finds it by name after.
      "migrations_dir": "migrations"
    }
  ]
}
